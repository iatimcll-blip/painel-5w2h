rules_version = '2';
// Rotinas de Trabalho — regras de acesso do Firestore.
// Administrador principal fixo: iatimcll@gmail.com (e-mail verificado, por exemplo ao entrar com Google).
// Novos usuários entram como "pendente" e só acessam os dados depois que um administrador aprova o pedido.
// Contas criadas antes da aprovação existir (sem o campo status) continuam aprovadas.
// O administrador pode promover outros administradores e liberar privilégios por usuário:
//   verEquipe      — ver os trabalhos e a evolução de todos (sem editar)
//   editarEquipe   — editar os trabalhos dos outros (inclui ver)
//   editarPrograma — alterar título, empresa, responsável e parecer do programa
//   excluir        — apagar trabalhos (os próprios, ou os da equipe se também tiver editarEquipe)
// Sem privilégios, o usuário vê e edita só os próprios trabalhos e não apaga nada.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function superAdmin() {
      return signedIn() && request.auth.token.email == 'iatimcll@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function temPerfil() { return exists(/databases/$(database)/documents/perfis/$(me())); }
    function perfil() { return get(/databases/$(database)/documents/perfis/$(me())).data; }
    function isAdmin() { return superAdmin() || (signedIn() && temPerfil() && perfil().papel == 'admin'); }
    function aprovado() { return isAdmin() || (signedIn() && temPerfil() && perfil().get('status', 'aprovado') == 'aprovado'); }
    function priv(k) { return aprovado() && perfil().get('priv', {}).get(k, false) == true; }
    function verEquipe() { return isAdmin() || priv('verEquipe') || priv('editarEquipe'); }
    function editarEquipe() { return isAdmin() || priv('editarEquipe'); }
    function meu(data) { return aprovado() && data.owner == me(); }
    function podeExcluir(data) {
      return isAdmin() || (priv('excluir') && (data.owner == me() || priv('editarEquipe')));
    }
    function semPrivilegios() {
      return request.resource.data.priv == {'verEquipe': false, 'editarEquipe': false, 'editarPrograma': false, 'excluir': false};
    }
    function privValidos() {
      return request.resource.data.priv.keys().hasOnly(['verEquipe', 'editarEquipe', 'editarPrograma', 'excluir'])
        && request.resource.data.priv.values().hasOnly([true, false]);
    }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /perfis/{uid} {
      allow read: if signedIn() && (uid == me() || verEquipe());
      // o cadastro nasce como pedido pendente; só o administrador principal nasce aprovado
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nome', 'email', 'papel', 'criado_em', 'priv', 'status', 'pedido'])
        && request.resource.data.email == request.auth.token.email
        && semPrivilegios()
        && ((request.resource.data.papel == 'usuario' && request.resource.data.status == 'pendente')
          || (superAdmin() && request.resource.data.papel == 'admin' && request.resource.data.status == 'aprovado'));
      allow update: if signedIn() && (
        // a própria pessoa muda o nome e a mensagem do pedido
        (uid == me() && mudou().hasOnly(['nome', 'pedido']))
        // pedido recusado pode ser enviado de novo
        || (uid == me() && resource.data.get('status', 'aprovado') == 'recusado' && request.resource.data.status == 'pendente'
          && mudou().hasOnly(['status', 'pedido']))
        // o administrador principal garante o próprio acesso
        || (uid == me() && superAdmin() && request.resource.data.papel == 'admin' && request.resource.data.get('status', 'aprovado') == 'aprovado'
          && mudou().hasOnly(['nome', 'papel', 'status']))
        // administradores aprovam, recusam e mudam papel e privilégios dos outros, nunca do administrador principal
        || (isAdmin() && uid != me() && resource.data.email != 'iatimcll@gmail.com'
          && mudou().hasOnly(['papel', 'priv', 'status'])
          && request.resource.data.papel in ['usuario', 'admin']
          && request.resource.data.get('status', 'aprovado') in ['pendente', 'aprovado', 'recusado'] && privValidos()));
      allow delete: if false;
    }

    match /profissionais/{id} {
      allow read: if signedIn() && (meu(resource.data) || verEquipe());
      allow create: if signedIn() && (meu(request.resource.data) || isAdmin());
      allow update: if signedIn() && (meu(resource.data) || editarEquipe())
        && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && podeExcluir(resource.data);
    }

    match /historico/{id} {
      allow read: if signedIn() && (meu(resource.data) || verEquipe());
      allow create: if signedIn() && (meu(request.resource.data) || editarEquipe());
      allow update: if signedIn() && (meu(resource.data) || editarEquipe())
        && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && podeExcluir(resource.data);
    }

    match /config/{id} {
      allow read: if signedIn() && aprovado();
      allow write: if isAdmin() || priv('editarPrograma');
    }
  }
}
